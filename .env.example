# ============================================================
# Wanderlust — environment configuration
# ============================================================
# Copy to .env and fill in. NEVER commit real credentials.

# ---- Database (SERVER-SIDE ONLY) -------------------------------------------
# PostgreSQL / Neon connection string. Read exclusively by server/* and db/*.
# Do NOT prefix with VITE_ — anything Vite can see is bundled into the browser.
# Neon example: postgresql://user:password@ep-cool-name-123456.eu-central-1.aws.neon.tech/wanderlust?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/wanderlust

# Optional: force the driver ('neon-http' | 'pg'). Auto-detected from the
# host when unset (*.neon.tech -> neon-http, everything else -> pg).
DB_DRIVER=

# Optional: apply seed/verify/corrupt/repair against a non-public schema.
DB_SCHEMA=public

# ---- Server ----------------------------------------------------------------
# Port for the Express API (Vite proxies /api here in dev).
PORT=8787

# Optional: override the dev proxy target.
# API_PROXY_TARGET=http://localhost:8787
